{
    // The ID of your mod. Should be unique!!
    "id": "hometown-mod-i18n",
    // Whether development-only features are enabled.
    "dev": true,
    // Displays on the main menu.
    "name": "Hometown Mod",
    // Displays underneath the name. Optional.
    "subtitle": "",

    // The version of your mod.
    "version": "v0.1.1", // x-release-please-version
    // What version of the engine your mod was made with.
    "engineVer": "v0.11.0-dev",

    // The Deltarune chapter you'd like to base your mod off of.
    // Do keep in mind that you can control chapter-specific features
    // one by one using the config below.
    "chapter": 5,

    // The map that you start in when first starting the mod.
    "map": "light/hometown/torielhouse/kris_room",

    // The party. The first character is the player.
    "party": ["kris"],

    // The light-world inventory. Contains a ball of junk, cards, a cell phone and a shadow crystal by default.
    "lightInventory": {
        "items": ["light/ball_of_junk", "light/cards"],
        "key_items": ["cell_phone", "shadowcrystal"]
    },

    // Should never be true, but just in case. Restarts the entire engine when leaving the mod.
    // If you need this, you're most likely doing something wrong.
    "hardReset": false,

    // Whether the mod is hidden from the mod selection.
    "hidden": false,

    // Whether the game window's title should be set to the mod's name, and the icon to the image
    // in the file `window_icon.png`.
    // When your mod is configured as the engine's target mod, it's automatically done unless if
    // this option is explicitly set to false; else, it's done if this is set to true.
    "setWindowTitleAndIcon": null,

    // Config values for the engine and any libraries you may have.
    // These config values can control chapter-specific features as well.
    "config": {
        "kristal": {
            "enableRecruits": true,
            // End of config
        },
        "kristalI18n": {
            "defaultLanguage": "auto",
            // 默认角色名称语言：英文。玩家可在运行时切换（Game:setNameLanguage），
            // 选择会存入存档并在读档后优先。
            "defaultNameLanguage": "en",
            "languages": ["en", "zh_hans"],
            "languageNames": {
                "en": "English",
                "zh_hans": "简体中文"
            }
        },
        "kristal-object-selector-plus": {
            "enabled": true,
            "snap_grid": 1,
            "snap_angle": 5,
            "snap_scale": 0.1,
            "fine_factor": 0.1,
            "wheel_scale_step": 0.1,
            "wheel_rotate_step": 5,
            "max_undo": 64
        },
        "terminal-cli": {
            "enabled": true,
            "only_dev": true,
            "max_commands_per_frame": 8
        },
        "kristal-debug-tools": {
            "enabled": true,
            "only_dev": true,
            "default_encounter": "dummy",
            "initial_tp": null,
            "initial_mercy": null
        },
        "virtualkeyboard": {
            "enabled": true,
            "only_android": true,
            "show_on_start": true,
            "layout": "buttons",
            "toggle_key": null,
            "opacity": 0.78,
            "button_scale": 2.5,
            "button_radius": 38,
            "direction_area_radius": 122,
            "direction_deadzone": 0.2,
            "joystick_scale": 2.5,
            "joystick_radius": 108,
            "joystick_deadzone": 0.35
        }
    }
}
